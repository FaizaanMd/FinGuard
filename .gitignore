# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Secrets & local config
.env
*.local

# Data — raw downloads and derived outputs are excluded.
# See data/README.md for how to obtain the dataset.
data/raw/*
data/processed/*
data/interim/*
data/dashboard_export/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/interim/.gitkeep
!data/dashboard_export/.gitkeep

# Serialized models (large binaries)
models/*.joblib
models/*.pkl

# Logs
*.log

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
# Executed notebooks (reproduce via nbconvert)
notebooks/*_executed.ipynb
